# ─────────────────────────────────────────────────────────────────────────────
# Student Success Hub — environment configuration
#
# Copy to `.env` and fill in the values:  cp .env.example .env
# `.env` is gitignored. Never commit real secrets.
#
# Variables marked REQUIRED (prod) are validated at startup when
# NODE_ENV=production — the server refuses to boot without them.
# ─────────────────────────────────────────────────────────────────────────────

# Runtime mode: development | production | test
NODE_ENV=development

# Port the API server listens on.
# Defaults to 3001 in development and 3000 in production.
PORT=3001

# ── Authentication ───────────────────────────────────────────────────────────

# REQUIRED (prod). Signing key for auth JWTs. Minimum 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# In development a random key is generated at boot if this is unset, which means
# sessions are invalidated on every restart.
JWT_SECRET=

# REQUIRED (prod). Google OAuth client ID. Public value — also read by the
# frontend via the VITE_ prefix. Create one at:
# https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=

# REQUIRED (prod). Google OAuth client secret. Obtained from the same OAuth
# client in Google Cloud Console as the client ID above. Keep this secret —
# server-only, never expose to the frontend. Required for server-side Google
# sign-in flow.
GOOGLE_CLIENT_SECRET=

# Optional. Full OAuth redirect URI that Google redirects back to after consent.
# Defaults to ${CLIENT_URL}/api/auth/google/callback if unset.
# IMPORTANT: Must EXACTLY match an "Authorized redirect URI" registered in your
# Google Cloud Console → Credentials → OAuth 2.0 Client. Register BOTH:
#   Production: https://<your-vercel-domain>/api/auth/google/callback
#   Local dev:  http://localhost:3000/api/auth/google/callback
GOOGLE_REDIRECT_URI=

# ── Access control ───────────────────────────────────────────────────────────

# REQUIRED (prod). Email address granted access to /admin.
ADMIN_EMAIL=

# ── Networking ───────────────────────────────────────────────────────────────

# REQUIRED (prod). Origin allowed by CORS and Socket.io, no trailing slash.
# Example: https://student-guide-green.vercel.app
CLIENT_URL=http://localhost:3000

# ── Database ─────────────────────────────────────────────────────────────────

# REQUIRED (prod). Turso / libSQL connection URL.
# Unset in development falls back to a local `file:./local.db`.
# Example: libsql://your-db-name-org.turso.io
TURSO_DATABASE_URL=

# Required whenever TURSO_DATABASE_URL is set.
TURSO_AUTH_TOKEN=

# ── Observability ────────────────────────────────────────────────────────────

# Optional. Sentry DSN for error reporting. Errors log to stdout when unset.
SENTRY_DSN=

# Log verbosity: debug | info | warn | error | silent
LOG_LEVEL=info
